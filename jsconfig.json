{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@root/*": ["./"],
      "@src/*": ["./src/*"],
      "@node_modules": ["./src/node_modules"],
      "@backend/*": ["./src/backend/*"],
      "@frontend/*": ["./src/frontend/*"],
      "@controllers/*": ["./src/backend/controllers/*"],
      "@modules/*": ["src/frontend/static/modules/*"],
      "@services/*": ["./src/backend/services/*"],
      "@routes/*": ["./src/backend/routes/*"],
      "@views/*": ["./src/frontend/views/*"],
      "@static/*": ["./src/frontend/static/*"],
      "@css/*": ["./src/frontend/static/css/*"],
      "@js/*": ["./src/frontend/static/js/*"],
      "@imgs/*": ["./src/frontend/static/imgs/*"]
    }
  }
}