generator client {
    provider = "prisma-client-js"
}

datasource db {
    url      = env("DATABASE_URL")
    provider = "postgresql"
}

model User {
    id           String         @id @default(uuid()) // Corrigido para ser a chave primária
    username     String         @unique
    name         String
    email        String         @unique
    password     String
    phone        String
    createdAt    DateTime       @default(now())
    updatedAt    DateTime       @updatedAt
    avatar       Avatar[]
    auth         String?
    AuthProvider AuthProvider[]
}

model AuthProvider {
    id           String   @id @default(uuid()) // Removido @unique, pois já é a chave primária
    provider     String   @unique // Ex: 'google', 'facebook', 'github'
    userId       String // ID do usuário no provedor de autenticação
    accessToken  String? // Token de acesso do usuário
    refreshToken String? // Token de atualização do usuário
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    user         User     @relation(fields: [userId], references: [id])
}

model Avatar {
    id                String       @id @default(uuid())
    owner             User         @relation(fields: [userId], references: [id])
    userId            String
    name              String
    race              Races        @relation(fields: [raceId], references: [id])
    raceId            Int
    atributos         Atributos    @relation(fields: [atributosId], references: [id])
    atributosId       String       @unique
    habilidades       Habilidade[]
    inventory         Inventory[]
    level             Int
    tier              Int
    experience_actual Int
    experience_total  Int
    quests            Quest[]
    createdAt         DateTime     @default(now())
    updatedAt         DateTime     @updatedAt
    Reward            Reward[]
}

model Races {
    id          Int    @id @default(autoincrement())
    name        String
    description String
    Avatar Avatar[]
}

model AtributeBonus {
    id               String @id @default(uuid())
    name             String
    valorIncremento  Int
}

model RaceHability {
    id           String @id @default(uuid())
    name         String
    
}

model Atributos {
    id               String         @id @default(uuid())
    avatar           Avatar?
    monster          Monster? // Removido @relation
    monsterId        String? // Chave estrangeira
    avatarId         String?
    strength         Int
    agility          Int
    defence          Int
    resistance       Int
    intelligence     Int
    vitality         Int
    energy_points    Int
    energy_types     Energy_types[]
    attribute_points Int
    skill_points     Int
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt
}

model Monster {
    id          Int      @id @default(autoincrement())
    name        String
    atributos   Atributos   @relation(fields: [atributosId], references: [id])
    atributosId String      @unique
    description String
    level       Int
    inventory   Inventory[]
    rewards     Reward[] // Relação com as recompensas do monstro
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
}

enum HabilityType {
    Active
    Passive
}

enum HabilityEffect {
    Attack
    Defence
    Heal
    Magic_Ignis
    Magic_Aqua
    Magic_
    Magic_of_fire
    Magic_of_water

}

model Habilidade {
    id          Int            @id @default(autoincrement())
    avatar      Avatar         @relation(fields: [avatarId], references: [id])
    avatarId    String
    name        String         @unique
    duration    Int
    power       Int
    effect      String
    type        HabilityType
    energy_cost String
    level       Int
    tier        Int
    createdAt   DateTime       @default(now())
    updatedAt   DateTime       @updatedAt
}

model Inventory {
    id         String   @id @default(uuid())
    avatar     Avatar?  @relation(fields: [avatarId], references: [id])
    monster    Monster? @relation(fields: [monsterId], references: [id])
    monsterId  Int?
    avatarId   String?
    pesoMax    Int
    pesoActual Int
    items      Item[]
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}

model Inventory_types {
    id           Int    @id @default(autoincrement())
    name         String
    quantitySlot Int
}

model Energy_types {
    id          Int       @id @default(autoincrement())
    atributos   Atributos @relation(fields: [atributosId], references: [id])
    atributosId String
    energia     String
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
}

model Item {
    id          String      @id @default(uuid())
    inventory   Inventory   @relation(fields: [inventoryId], references: [id])
    inventoryId String
    name        String      @unique
    description String
    peso        Int
    quality     ItemQuality
    item_type   ItemType
    rules       String
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
    Reward      Reward[]
}

enum ItemQuality {
    comum
    raro
    epico
    lendario
}

enum ItemType {
    arma
    armadura
    pocao
    material
}

model Quest {
    id            String      @id @default(uuid())
    avatar        Avatar      @relation(fields: [avatarId], references: [id])
    avatarId      String
    name          String
    description   String
    status        QuestStatus
    completed     Boolean
    current_stage Int
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt
}

enum QuestStatus {
    pendente
    emAndamento
    concluida
    falha
}

enum RewardType {
    Moeda
    Item
    Experiencia
}

model Reward {
    id          String     @id @default(uuid())
    avatar      Avatar?    @relation(fields: [avatarId], references: [id]) // Relação com Avatar (opcional)
    avatarId    String?
    type        String
    value       String
    quantity    Int        @default(1)
    actionType  String? // Tipo de ação que gerou a recompensa (ex: "monstroDerrotado", "subirNivel", "evento")
    actionId    String? // ID da ação (ex: ID do monstro derrotado, ID do evento)
    item        Item?      @relation(fields: [itemId], references: [id]) // Relação com Item (opcional)
    itemId      String?
    rewardType  RewardType
    moedaAmount Int?
    xpAmount    Int? // Se RewardType for Experiencia
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt
    Monster     Monster[] // Verifique se isso é necessário
    Event       Event[] // Verifique se isso é necessário
}

model Event {
    id          String   @id @default(uuid())
    name        String
    description String
    startDate   DateTime
    endDate     DateTime
    rewards     Reward[] // Relação com as recompensas do evento
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}
