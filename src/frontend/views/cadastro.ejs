<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>rpg model</title>
  <link rel="shortcut icon" type="image/jpg" href="./../static/imgs/Capa_logo.png" sizes="16x16"/>
  <!-- <script preload src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script> -->
  <link type="text/css" rel="stylesheet" href="./../static/css/login.css" />
</head>
<body>
  <div class="img_background"></div>
  <h1 class="text-template"></h1>
  <form modo="cadastro">
    <div class="linha login"> <!-- Username -->
      <label for="username">Username:</label>
      <input type="text" name="username" id="username" autocomplete="on"/>
    </div>
    <div class="linha register"> <!-- Nome Usuario -->
      <label for="name">Nome Completo:</label>
      <input type="text" name="name" id="name" autocomplete="off"/>
    </div>
    <div class="linha login"> <!-- Pass -->
      <label for="password">Senha:</label>
      <input type="password" name="password" id="password" autocomplete="on"/>
    </div>
    <div class="linha register"> <!-- Co-Pass -->
      <label for="co_password">Confirmação de Senha:</label>
      <input type="password" name="co_password" id="co_password" autocomplete="off"/>
    </div>
    <div class="linha register"> <!-- Email -->
      <label for="email">E-mail:</label>
      <input type="email" name="email" id="email" autocomplete="on"/>
    </div>
    <div class="linha register"> <!-- Phone -->
      <label for="phone">Phone:</label>
      <input type="number" name="phone" id="phone" autocomplete="on"/>
    </div>
    <div class="espace-enter">
      <input type="submit" value="CRIAR" id="btn_criar"/>
      <input type="submit" value="LOGAR" id="btn_logar"/>
    </div>
  </form>
  <script type="module" src="./../static/js/cadastro.js"></script>
</body>
</html>