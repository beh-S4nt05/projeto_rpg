<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Client Page</title>
  <link rel="shortcut icon" type="image/jpg" href="./../static/imgs/Capa_logo.png" sizes="16x16" />
  <link type="text/css" rel="stylesheet" href="./../static/css/index.css" />
</head>

<body>
  <aside class="menu close" visibility="open">
    <ul>
      <li>
        <i class="fa-solid fa-user"></i>
        <p>Pessoa</p><span>pessoa</span>
      </li>
      <li>
        <i class="fa-solid fa-globe"></i>
        <p>Classes</p><span>classes</span>
      </li>
      <li>
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        <p>Habilidades</p><span>habilidades</span>
      </li>
      <li>
        <i class="fa-solid fa-dungeon"></i>
        <p>Salas</p><span>salas</span>
      </li>
      <li>
        <i class="fa-solid fa-border-all"></i>
        <p>Inventário</p><span>inventário</span>
      </li>
      <li>
        <i class="fa-solid fa-user-group"></i>
        <p>Amigos</p><span>amigos</span>
      </li>
      <li>
        <i class="fa-solid fa-fire-flame-curved"></i>
        <p>Forja</p><span>forja</span>
      </li>
    </ul>
  </aside>
  <main class="grade">
    <div class="col1" visibility="open">
      <details> <!-- Dados -->
        <summary>Dados:</summary>
        <article>
          <div id="dados">
            <div class="dadosAvatar">
              <p class="dadosPlayer">Player: <%= user.username %></p>
            </div>
            <div class="dadosAvatar">
              <p class="dadosLvl"></p>
            </div>
            <div class="dadosAvatar">
              <p class="dadosExp"></p>
            </div>
            <div class="dadosAvatar">
              <p class="dadosNome">Nome:</p>
              <input type="text" id="name" name="name" autocomplete="off"/>
            </div>
            <div class="dadosAvatar">
              <p class="dadosRaça">Raça:</p>
              <select id="race" name="race">
                <option>Humano</option>
                <option>Anão</option>
                <option>Meio-Anão</option>
                <option>Halfliing</option>
                <option>Gnomo</option>
                <option>Elfo</option>
                <option>Meio-Elfo</option>
                <option>Meio_Orc</option>
                <option>Tiefling</option>
                <option>Usagi</option>
                <option>Tora</option>
                <option>Karasu</option>
                <option>Kitsune</option>
                <option>Inu</option>
                <option>Neko</option>
                <option>Meio-Gênio</option>
                <option>Sátiro</option>
                <option>Customizado</option>
              </select>
            </div>
            <div class="dadosAvatar">
              <p class="dadosIdade">Idade:</p>
              <input type="number" min="0" maxlength="7" id="idade" name="idade"  autocomplete="off"/>
            </div>
            <div class="dadosAvatar">
              <p class="dadosGenero">Gênero:</p>
              <select id="gender">
                <option>Masculino</option>
                <option>Feminino</option>
              </select>
            </div>
            <input type="button" value="salvar" />
          </div>
        </article>
      </details>
      <details> <!-- Classes -->
        <summary>Classes:</summary>
      </details>
      <details open> <!-- Atributos -->
        <summary>Atributos:</summary>
        <article>
          <div id="atributos"> <!-- Pontos de Atributos, disponíveis -->
            <p class="dadosPontos"></p>
            <div class="atributosAvatar"> <!-- Tamanho -->
              <p class="atributos">Tamanho: <span tamanho></span></p>
              <div class="divisorAtributes">
                <div class="addAtributes">
                  <button type="button">+1</button>
                  <button type="button">+5</button>
                  <button type="button">+10</button>
                  <button type="button">+50</button>
                </div>
                <div class="subAtributes">
                  <button type="button">-1</button>
                  <button type="button">-5</button>
                  <button type="button">-10</button>
                  <button type="button">-50</button>
                </div>
              </div>
            </div>
            <div class="atributosAvatar"> <!-- Forca -->
              <p class="atributos">Força: <span forca></span></p>
              <div class="divisorAtributes">
                <div class="addAtributes">
                  <button type="button">+1</button>
                  <button type="button">+5</button>
                  <button type="button">+10</button>
                  <button type="button">+50</button>
                </div>
                <div class="subAtributes">
                  <button type="button">-1</button>
                  <button type="button">-5</button>
                  <button type="button">-10</button>
                  <button type="button">-50</button>
                </div>
              </div>
            </div>
            <div class="atributosAvatar"> <!-- Constituicao -->
              <p class="atributos">Constituição: <span constituicao></span></p>
              <div class="divisorAtributes">
                <div class="addAtributes">
                  <button type="button">+1</button>
                  <button type="button">+5</button>
                  <button type="button">+10</button>
                  <button type="button">+50</button>
                </div>
                <div class="subAtributes">
                  <button type="button">-1</button>
                  <button type="button">-5</button>
                  <button type="button">-10</button>
                  <button type="button">-50</button>
                </div>
              </div>
            </div>
            <div class="atributosAvatar"> <!-- Destreza -->
              <p class="atributos">Destreza: <span destreza></span></p>
              <div class="divisorAtributes">
                <div class="addAtributes">
                  <button type="button">+1</button>
                  <button type="button">+5</button>
                  <button type="button">+10</button>
                  <button type="button">+50</button>
                </div>
                <div class="subAtributes">
                  <button type="button">-1</button>
                  <button type="button">-5</button>
                  <button type="button">-10</button>
                  <button type="button">-50</button>
                </div>
              </div>
            </div>
            <div class="atributosAvatar"> <!-- Aparencia -->
