                  <button type="button">+1</button>
                  <button type="button">+5</button>
                  <button type="button">+10</button>
                  <button type="button">+50</button>
                </div>
                <div class="subAtributes">
                  <button type="button">-1</button>
                  <button type="button">-5</button>
                  <button type="button">-10</button>
                  <button type="button">-50</button>
                </div>
              </div>
            </div>
            <div class="atributosAvatar"> <!-- Inteligencia -->
              <p class="atributos">Inteligência: <span inteligencia></span></p>
              <div class="divisorAtributes">
                <div class="addAtributes">
                  <button type="button">+1</button>
                  <button type="button">+5</button>
                  <button type="button">+10</button>
                  <button type="button">+50</button>
                </div>
                <div class="subAtributes">
                  <button type="button">-1</button>
                  <button type="button">-5</button>
                  <button type="button">-10</button>
                  <button type="button">-50</button>
                </div>
              </div>
            </div>
            <div class="atributosAvatar"> <!-- Educacao -->
              <p class="atributos">Educação: <span educacao></span></p>
              <div class="divisorAtributes">
                <div class="addAtributes">
                  <button type="button">+1</button>
                  <button type="button">+5</button>
                  <button type="button">+10</button>
                  <button type="button">+50</button>
                </div>
                <div class="subAtributes">
                  <button type="button">-1</button>
                  <button type="button">-5</button>
